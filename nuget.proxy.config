<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore WITH the network, through the local proxy.
       Why this file exists: on this machine the .NET TLS stack cannot reach
       api.nuget.org directly ("Authentication failed / no credentials available
       in the security package" from schannel), while a proxied connection works.
       Pass it explicitly to dotnet publish as the NuGet config; build.ps1 already
       does that and exports HTTP(S)_PROXY. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- Same place NuGet uses by default; NuGet expands %VAR% in config values. -->
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>
</configuration>
