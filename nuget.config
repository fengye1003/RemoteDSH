<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Fully offline restore, for machines whose TLS stack cannot reach
       api.nuget.org (a schannel fault). Every package the NativeAOT publish needs
       is already present in the global packages folder; no remote source is
       declared, so the restore never attempts the network. -->
  <packageSources>
    <clear />
  </packageSources>
  <config>
    <!-- Same place NuGet uses by default; NuGet expands %VAR% in config values. -->
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>
</configuration>
